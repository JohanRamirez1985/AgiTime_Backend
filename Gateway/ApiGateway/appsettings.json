{
  "ReverseProxy": {
    "Routes": {
      "usuarios": {
        "ClusterId": "usuariosCluster",
        "Match": { "Path": "/usuarios/{**catch-all}" }
      },
      "clientes": {
        "ClusterId": "clientesCluster",
        "Match": { "Path": "/clientes/{**catch-all}" }
      }
    },
    "Clusters": {
      "usuariosCluster": {
        "Destinations": {
          "dest1": { "Address": "http://usuarios.api/" }
        }
      },
      "clientesCluster": {
        "Destinations": {
          "dest1": { "Address": "http://clientes.api/" }
        }
      }
    }
  }
}
